# ==========================================
# Zyro HR Assistant - Backend Environment Config
# ==========================================

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=False

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=https://zyro-hr-backend.onrender.com

# Vectorstore & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_DIR=backend/data/hr_faiss_index
EMBEDDING_DIMENSION=384

# Retrieval Hyperparameters (Match Kaggle Pipeline)
RETRIEVER_K=4
RETRIEVER_FETCH_K=12
RETRIEVER_LAMBDA_MULT=0.5

# Admin Protection
ADMIN_API_KEY=zyro-admin-secret-token-change-in-production

